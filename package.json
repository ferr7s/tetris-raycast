{
  "name": "tetris-raycast",
  "title": "Tetris",
  "description": "Play a compact Tetris game inside Raycast.",
  "icon": "icon.png",
  "author": "matheus_ferrari",
  "platforms": ["macOS", "Windows"],
  "categories": ["Fun"],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Play Tetris",
